        <GradientStop Color="#2752C0" Offset="0.8529" />
        <GradientStop Color="#2752C0" Offset="0.8824" />
        <GradientStop Color="#1D3A8A" Offset="0.8824" />
        <GradientStop Color="#1D3A8A" Offset="0.9118" />
        <GradientStop Color="#2752C0" Offset="0.9118" />
        <GradientStop Color="#2752C0" Offset="0.9412" />
        <GradientStop Color="#1D3A8A" Offset="0.9412" />
        <GradientStop Color="#1D3A8A" Offset="0.9706" />
        <GradientStop Color="#2752C0" Offset="0.9706" />
        <GradientStop Color="#2752C0" Offset="1.0000" />
    </LinearGradientBrush>
    <Style x:Key="CardBack" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Background" Value="{StaticResource CardBackStripes}" />
        <Setter Property="Stroke" Value="#FF0C1C4A" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- The dealer puck: a gold disc -->
    <RadialGradientBrush x:Key="DealerPuckBrush" Center="0.32,0.3" Radius="0.7">
        <GradientStop Color="#FFFFF8D8" Offset="0" />
        <GradientStop Color="#FFF0D878" Offset="0.35" />
        <GradientStop Color="#FFC8A23A" Offset="0.8" />
        <GradientStop Color="#FF8B6F1A" Offset="1" />
    </RadialGradientBrush>

    <!-- The avatar disc on each nameplate -->
    <LinearGradientBrush x:Key="AvatarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF555555" Offset="0" />
        <GradientStop Color="#FF222222" Offset="1" />
    </LinearGradientBrush>

    <!-- .panel: the tricks and score panels, the trick info -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBackground}" />
        <Setter Property="Stroke" Value="{StaticResource PanelBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- The height of a button in the panels: 48 on a phone or tablet, the touch-target
         size Android and Material ask for, and the Blazor UI's 34 with a mouse. -->
    <OnIdiom x:Key="TouchTarget" x:TypeArguments="x:Double" Phone="48" Tablet="48" Default="34" />

    <!-- .modal-card -->
    <Style x:Key="ModalCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="BackgroundColor" Value="#FF1A3A26" />
        <Setter Property="Stroke" Value="{StaticResource PanelBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{OnIdiom Phone='20,12', Default='32,24'}" />
        <Setter Property="MinimumWidthRequest" Value="300" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="ModalTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Gold}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="{OnIdiom Phone='0,0,0,6', Default='0,0,0,12'}" />
    </Style>
    <Style x:Key="ModalSub" TargetType="Label">
        <Setter Property="TextColor" Value="#FFCFCFCF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="{OnIdiom Phone='0,0,0,6', Default='0,0,0,12'}" />
    </Style>

    <!-- .btn and its variants -->
    <Style x:Key="TableButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#99000000" />
        <Setter Property="BorderColor" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource TextLight}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#CC000000" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TableButton}">
        <Setter Property="BackgroundColor" Value="#CC286E3C" />
        <Setter Property="BorderColor" Value="#FF6CF06C" />
        <Setter Property="TextColor" Value="#FFEAFFEA" />
    </Style>
    <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource TableButton}">
        <Setter Property="TextColor" Value="#FFFF8A8A" />
    </Style>

</ResourceDictionary>
