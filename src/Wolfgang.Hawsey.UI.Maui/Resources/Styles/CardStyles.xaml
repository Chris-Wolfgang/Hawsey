<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Card dimensions -->
    <x:Double x:Key="CardWidth">60</x:Double>
    <x:Double x:Key="CardHeight">90</x:Double>
    <x:Double x:Key="CardCornerRadius">6</x:Double>

    <!-- Card colors -->
    <Color x:Key="CardBackground">#FFFFF8E1</Color>
    <Color x:Key="CardBorder">#FF424242</Color>
    <Color x:Key="CardBackColor">#FF1565C0</Color>
    <Color x:Key="RedSuitColor">#FFC62828</Color>
    <Color x:Key="BlackSuitColor">#FF212121</Color>
    <Color x:Key="LegalPlayHighlight">#FF66BB6A</Color>
    <Color x:Key="SelectedCardBorder">#FFFFD600</Color>

    <!-- Table colors -->
    <Color x:Key="TableGreen">#FF1B5E20</Color>
    <Color x:Key="TableFelt">#FF2E7D32</Color>

    <!-- Font sizes -->
    <x:Double x:Key="CardRankFontSize">14</x:Double>
    <x:Double x:Key="CardSuitFontSize">22</x:Double>
    <x:Double x:Key="ScoreFontSize">16</x:Double>

</ResourceDictionary>
