<?xml version="1.0" encoding="utf-8" ?>
<!-- The table's look, taken from the Blazor UI's site.css so both UIs look the same. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- site.css :root -->
    <Color x:Key="Gold">#FFD4AF37</Color>
    <Color x:Key="UsBlue">#FF4A9EFF</Color>
    <Color x:Key="ThemRed">#FFE84A4A</Color>
    <Color x:Key="PanelBackground">#8C000000</Color>
    <Color x:Key="PanelBorder">#99D4AF37</Color>
    <Color x:Key="CardFace">#FFFBF6E9</Color>
    <Color x:Key="TextLight">#FFF5F5F5</Color>
    <Color x:Key="WinGreen">#FF6CF06C</Color>

    <!-- Hand card borders, read by BoolToStrokeConverter: a playable card and the rest -->
    <Color x:Key="LegalPlayHighlight">#FF6CF06C</Color>
    <Color x:Key="CardBorder">#FF6B6B6B</Color>

    <!-- The felt: .table's radial gradient, with the wood rim around it -->
    <RadialGradientBrush x:Key="FeltBrush" Center="0.5,0.5" Radius="0.75">
        <GradientStop Color="#FF2A7048" Offset="0" />
        <GradientStop Color="#FF1F5938" Offset="0.55" />
        <GradientStop Color="#FF14391F" Offset="1" />
    </RadialGradientBrush>
    <Color x:Key="TableRim">#FF6B3A18</Color>

    <!-- The face-down cards in the AI seats' hands (.card-back) -->
    <LinearGradientBrush x:Key="CardBackStripes" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D3A8A" Offset="0.0000" />
        <GradientStop Color="#1D3A8A" Offset="0.0294" />
        <GradientStop Color="#2752C0" Offset="0.0294" />
        <GradientStop Color="#2752C0" Offset="0.0588" />
        <GradientStop Color="#1D3A8A" Offset="0.0588" />
        <GradientStop Color="#1D3A8A" Offset="0.0882" />
        <GradientStop Color="#2752C0" Offset="0.0882" />
        <GradientStop Color="#2752C0" Offset="0.1176" />
        <GradientStop Color="#1D3A8A" Offset="0.1176" />
        <GradientStop Color="#1D3A8A" Offset="0.1471" />
        <GradientStop Color="#2752C0" Offset="0.1471" />
        <GradientStop Color="#2752C0" Offset="0.1765" />
        <GradientStop Color="#1D3A8A" Offset="0.1765" />
        <GradientStop Color="#1D3A8A" Offset="0.2059" />
        <GradientStop Color="#2752C0" Offset="0.2059" />
        <GradientStop Color="#2752C0" Offset="0.2353" />
        <GradientStop Color="#1D3A8A" Offset="0.2353" />
        <GradientStop Color="#1D3A8A" Offset="0.2647" />
        <GradientStop Color="#2752C0" Offset="0.2647" />
        <GradientStop Color="#2752C0" Offset="0.2941" />
        <GradientStop Color="#1D3A8A" Offset="0.2941" />
        <GradientStop Color="#1D3A8A" Offset="0.3235" />
        <GradientStop Color="#2752C0" Offset="0.3235" />
        <GradientStop Color="#2752C0" Offset="0.3529" />
        <GradientStop Color="#1D3A8A" Offset="0.3529" />
        <GradientStop Color="#1D3A8A" Offset="0.3824" />
        <GradientStop Color="#2752C0" Offset="0.3824" />
        <GradientStop Color="#2752C0" Offset="0.4118" />
        <GradientStop Color="#1D3A8A" Offset="0.4118" />
        <GradientStop Color="#1D3A8A" Offset="0.4412" />
        <GradientStop Color="#2752C0" Offset="0.4412" />
        <GradientStop Color="#2752C0" Offset="0.4706" />
        <GradientStop Color="#1D3A8A" Offset="0.4706" />
        <GradientStop Color="#1D3A8A" Offset="0.5000" />
        <GradientStop Color="#2752C0" Offset="0.5000" />
        <GradientStop Color="#2752C0" Offset="0.5294" />
        <GradientStop Color="#1D3A8A" Offset="0.5294" />
        <GradientStop Color="#1D3A8A" Offset="0.5588" />
        <GradientStop Color="#2752C0" Offset="0.5588" />
        <GradientStop Color="#2752C0" Offset="0.5882" />
        <GradientStop Color="#1D3A8A" Offset="0.5882" />
        <GradientStop Color="#1D3A8A" Offset="0.6176" />
        <GradientStop Color="#2752C0" Offset="0.6176" />
        <GradientStop Color="#2752C0" Offset="0.6471" />
        <GradientStop Color="#1D3A8A" Offset="0.6471" />
