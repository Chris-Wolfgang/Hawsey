<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wolfgang.Hawsey.UI.Shared</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Chris Wolfgang</Authors>
    <Description>Razor components of the Hawsey Blazor UI. The game logic is the engine's GameSession.</Description>
    <Copyright>Copyright (c) Chris Wolfgang</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- An app, not a NuGet package (the SourceLink job skips non-packable projects),
         and its Razor components are not a documented API: opt out of the src/
         XML-doc default, like the MAUI app. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Hawsey.Engine\Wolfgang.Hawsey.Engine.csproj" />
  </ItemGroup>

</Project>
