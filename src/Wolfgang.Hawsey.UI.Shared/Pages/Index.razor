@page "/"
@using Wolfgang.Hawsey.Engine
@inject GameService Game
@implements IDisposable

<PageTitle>Hawsey</PageTitle>

<div class="table">

    <div class="panel tricks">
        <div class="label">Tricks (Total)</div>
        <div class="pair">
            <div class="col-us"><span class="heading">US</span><span class="value">@UsTricks</span></div>
            <div class="col-them"><span class="heading">THEM</span><span class="value">@ThemTricks</span></div>
        </div>
        <div class="trump">
            Trump: <span class="suit-mark @TrumpColorClass">@TrumpSymbol</span>
            @if (TrumpSetterTeam is not null)
            {
                <span class="who @(TrumpSetterTeam == "US" ? "us" : "them")">@TrumpSetterTeam</span>
                @if (BidAmountText is { } amt)
                {
                    <span class="bid-amount">· @amt</span>
                }
            }
        </div>
    </div>

    <div class="panel score">
        <div class="label">Score</div>
        <div class="pair">
            <div class="col-us"><span class="heading">US</span><span class="value">@UsScore</span></div>
            <div class="col-them"><span class="heading">THEM</span><span class="value">@ThemScore</span></div>
        </div>
    </div>

    <div class="seat partner">
        <div class="nameplate">
            <div class="avatar"></div>
            <span class="name">PARTNER</span>
            <span>Tricks: @TricksWon(PlayerPosition.North)</span>
        </div>
        <div class="opponent-hand">
            @for (var i = 0; i < HandCount(PlayerPosition.North); i++)
            {
                <div class="card-back"></div>
            }
        </div>
    </div>

    <div class="seat left">
        <div class="opponent-hand vertical">
            @for (var i = 0; i < HandCount(PlayerPosition.West); i++)
            {
                <div class="card-back"></div>
            }
        </div>
        <div class="nameplate">
            <div class="avatar"></div>
            <span class="name">OPPONENT LEFT</span>
            <span>Tricks: @TricksWon(PlayerPosition.West)</span>
        </div>
    </div>

    <div class="seat right">
        <div class="opponent-hand vertical">
            @for (var i = 0; i < HandCount(PlayerPosition.East); i++)
            {
                <div class="card-back"></div>
            }
        </div>
        <div class="nameplate">
            <div class="avatar"></div>
            <span class="name">OPPONENT RIGHT</span>
            <span>Tricks: @TricksWon(PlayerPosition.East)</span>
        </div>
    </div>

    <div class="trick-area">
        <div class="trick-slot north">
            @{ var north = PlayInTrick(PlayerPosition.North); }
            @if (north is not null) { @RenderPlayedCard(north) }
        </div>
        <div class="trick-slot west">
            @{ var west = PlayInTrick(PlayerPosition.West); }
            @if (west is not null) { @RenderPlayedCard(west) }
        </div>

        <div class="trick-info">
            <div class="heading">CURRENT TRICK</div>
            <div class="led">@LedByText</div>
            <div class="winner-label">Winning Card</div>
            <div class="winner-card">@WinningCardText</div>
        </div>

        <div class="trick-slot east">
            @{ var east = PlayInTrick(PlayerPosition.East); }
            @if (east is not null) { @RenderPlayedCard(east) }
        </div>
        <div class="trick-slot south">
            @{ var south = PlayInTrick(PlayerPosition.South); }
            @if (south is not null) { @RenderPlayedCard(south) }
        </div>
    </div>

    <div class="seat you">
        <div class="nameplate">
            <div class="avatar"></div>
            <span class="name">YOU</span>
            <span>Tricks: @TricksWon(PlayerPosition.South)</span>
        </div>
    </div>

    <div class="hand">
        @for (var i = 0; i < HumanHand.Count; i++)
        {
            var card = HumanHand[i];
            var legal = LegalPlays.Contains(card);
            var canPlay = IsHumanPlayTurn && legal;
            <div class="card @(IsRed(card) ? "red" : "") @(canPlay ? "playable" : "disabled")"
                 @onclick="() => OnCardClickAsync(card)">
                <span class="rank">@RankText(card.Rank)</span>
                <span class="suit">@SuitSymbol(card.Suit)</span>
            </div>
        }
    </div>

    <div class="statusbar">@StatusMessage</div>

    <div class="controls left">
        <button class="btn" @onclick="StartNewGameAsync">&#9776; NEW GAME</button>
    </div>

    @if (TrumpPickerVisible)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h2>Pick trump</h2>
                <div class="trump-buttons">
                    <button class="btn red"   @onclick="@(() => SelectTrumpAsync(Suit.Hearts))">♥ Hearts</button>
                    <button class="btn red"   @onclick="@(() => SelectTrumpAsync(Suit.Diamonds))">♦ Diamonds</button>
                    <button class="btn black" @onclick="@(() => SelectTrumpAsync(Suit.Clubs))">♣ Clubs</button>
                    <button class="btn black" @onclick="@(() => SelectTrumpAsync(Suit.Spades))">♠ Spades</button>
                </div>
                <button class="btn" @onclick="@(() => SelectTrumpAsync(null))">Ace High (no trump)</button>
            </div>
        </div>
    }

    @if (RoundSummary is { } rs)
    {
        <div class="modal-backdrop">
            <div class="modal-card round-summary">
                <h2>@(rs.IsGameOver ? $"{rs.GameWinnerLabel} wins the game!" : "Round complete")</h2>

                <div class="rs-bid">
                    <span class="@(rs.BidTeamLabel == "US" ? "us" : "them")">@rs.BidTeamLabel</span>
                    bid <strong>@rs.BidText</strong>
                    @(rs.Made
                        ? (MarkupString)"<span class=\"made\">made it</span>"
                        : (MarkupString)"<span class=\"set\">went set</span>")
                </div>

                <div class="rs-grid">
                    <div></div>
                    <div class="us">US</div>
                    <div class="them">THEM</div>

                    <div>Tricks</div>
                    <div>@rs.UsTricks</div>
                    <div>@rs.ThemTricks</div>

                    <div>This round</div>
                    <div class="@(rs.UsDelta < 0 ? "neg" : "pos")">@FormatDelta(rs.UsDelta)</div>
                    <div class="@(rs.ThemDelta < 0 ? "neg" : "pos")">@FormatDelta(rs.ThemDelta)</div>

                    <div>Total</div>
                    <div>@rs.UsTotal</div>
                    <div>@rs.ThemTotal</div>
                </div>

                @if (rs.IsGameOver)
                {
                    <button class="btn primary" @onclick="StartNewGameAsync">Play again</button>
                }
                else
                {
                    <button class="btn primary" @onclick="OnNextRoundAsync">Next round</button>
                }
            </div>
        </div>
    }

    @if (BidPickerVisible)
    {
        <div class="modal-backdrop bid-mode">
            <div class="modal-card">
                <h2>Your bid</h2>
                <p class="modal-sub">
                    @if (IsHumanStuck)
                    {
                        <span>You're <strong>stuck</strong> as dealer — bid <strong>@Game.MinimumLegalBid</strong> or call Hawsey.</span>
                    }
                    else if (Game.HighBidAmount > 0)
                    {
                        <span>Current high bid: <strong>@Game.HighBidAmount</strong></span>
                    }
                    else
                    {
                        <span>No bids yet. Minimum: <strong>@Game.MinimumLegalBid</strong></span>
                    }
                </p>
                <div class="bid-buttons">
                    @if (IsHumanStuck)
                    {
                        var stuckAmount = Game.MinimumLegalBid;
                        <button class="btn" @onclick="@(() => PlaceHumanBidAsync(new BidAction.NumberBid(stuckAmount)))">Bid @stuckAmount</button>
                    }
                    else
                    {
                        @for (var n = Game.MinimumLegalBid; n <= 11; n++)
                        {
                            var amount = n;
                            <button class="btn" @onclick="@(() => PlaceHumanBidAsync(new BidAction.NumberBid(amount)))">Bid @amount</button>
                        }
                    }
                </div>
                <button class="btn red" @onclick="@(() => PlaceHumanBidAsync(BidAction.HawseyBid.Instance))">Hawsey (24)</button>
                @if (!IsHumanStuck)
                {
                    <button class="btn" @onclick="@(() => PlaceHumanBidAsync(BidAction.PassBid.Instance))">Pass</button>
                }
            </div>
        </div>
    }

</div>

@code {
    private GameState? State => Game.CurrentState;
    private bool BidPickerVisible;
    private bool TrumpPickerVisible;
    private RoundSummarySnapshot? RoundSummary;
    private string StatusMessage = "Welcome to Hawsey. Click NEW GAME to start.";

    private sealed record RoundSummarySnapshot
    (
        string BidTeamLabel,
        string BidText,
        bool Made,
        int UsTricks,
        int ThemTricks,
        int UsDelta,
        int ThemDelta,
        int UsTotal,
        int ThemTotal,
        bool IsGameOver,
        string GameWinnerLabel
    );

    private static string FormatDelta(int n) => n > 0 ? $"+{n}" : n.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private bool IsHumanStuck
    {
        get
        {
            if (State is null) return false;
            if (State.Phase != GamePhase.Bidding) return false;
            if (State.NextToAct != PlayerPosition.South) return false;
            if (State.Dealer != PlayerPosition.South) return false;
            var bids = Game.BidHistory;
            if (bids.Count != 3) return false;
            for (var i = 0; i < bids.Count; i++)
            {
                if (bids[i].Action is not BidAction.PassBid) return false;
            }
            return true;
        }
    }

    private IReadOnlyList<Card> HumanHand
    {
        get
        {
            if (State is null) return Array.Empty<Card>();
            if (!State.Hands.TryGetValue(PlayerPosition.South, out var hand) || hand is null)
            {
                return Array.Empty<Card>();
            }
            return hand;
        }
    }

    private IReadOnlyList<Card> LegalPlays =>
        IsHumanPlayTurn ? State!.GetLegalPlays() : Array.Empty<Card>();

    private bool IsHumanPlayTurn =>
        State?.Phase == GamePhase.TrickPlay && State.NextToAct == PlayerPosition.South;

    private int UsScore => State?.NorthSouthScore ?? 0;
    private int ThemScore => State?.EastWestScore ?? 0;

    private int UsTricks => CountTricks(t => t == PlayerPosition.North || t == PlayerPosition.South);
    private int ThemTricks => CountTricks(t => t == PlayerPosition.East || t == PlayerPosition.West);

    private int CountTricks(Func<PlayerPosition, bool> match)
    {
        var tricks = State?.CompletedTricks;
        if (tricks is null) return 0;
        var count = 0;
        for (var i = 0; i < tricks.Count; i++) if (match(tricks[i].Winner)) count++;
        return count;
    }

    private int TricksWon(PlayerPosition p) =>
        State is null ? 0 : CountTricks(w => w == p);

    private int HandCount(PlayerPosition p) =>
        State?.Hands.TryGetValue(p, out var h) == true ? h.Count : 0;

    private string TrumpSymbol => State?.TrumpSuit is { } s ? SuitSymbol(s) : "—";
    private string TrumpColorClass => State?.TrumpSuit is Suit.Hearts or Suit.Diamonds ? "red" : "black";

    private string? TrumpSetterTeam
    {
        get
        {
            var winner = State?.BiddingResult?.Winner;
            if (winner is null) return null;
            return winner is PlayerPosition.North or PlayerPosition.South ? "US" : "THEM";
        }
    }

    private string? BidAmountText
    {
        get
        {
            var br = State?.BiddingResult;
            if (br is null) return null;
            return br.IsHawsey ? "Hawsey (24)" : br.BidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private string LedByText
    {
        get
        {
            if (Game.RecentlyCompletedTrick is { } recent && recent.Cards.Count > 0)
            {
                return $"Led by {LeaderName(recent.Cards[0].Player)}";
            }
            var trick = State?.CurrentTrick;
            if (trick is null || trick.Plays.Count == 0) return "";
            return $"Led by {LeaderName(trick.Plays[0].Player)}";
        }
    }

    private string WinningCardText
    {
        get
        {
            if (Game.RecentlyCompletedTrick is { } recent)
            {
                for (var i = 0; i < recent.Cards.Count; i++)
                {
                    if (recent.Cards[i].Player == recent.Winner)
                    {
                        var c = recent.Cards[i].Card;
                        return $"{RankText(c.Rank)} {SuitSymbol(c.Suit)}";
                    }
                }
            }
            var winner = State?.CurrentTrick?.GetCurrentWinner();
            return winner is null ? "—" : $"{RankText(winner.Value.Rank)} {SuitSymbol(winner.Value.Suit)}";
        }
    }

    private static string LeaderName(PlayerPosition p) => p switch
    {
        PlayerPosition.North => "Partner",
        PlayerPosition.East  => "Right",
        PlayerPosition.South => "You",
        PlayerPosition.West  => "Left",
        _ => p.ToString()
    };

    private PlayedCard? PlayInTrick(PlayerPosition p)
    {
        var plays = Game.RecentlyCompletedTrick is { } recent
            ? recent.Cards
            : State?.CurrentTrick?.Plays;

        if (plays is null) return null;
        for (var i = 0; i < plays.Count; i++)
        {
            if (plays[i].Player == p) return plays[i];
        }
        return null;
    }

    private static bool IsRed(Card c) => c.Suit is Suit.Hearts or Suit.Diamonds;

    private static string SuitSymbol(Suit s) => s switch
    {
        Suit.Hearts   => "♥",
        Suit.Diamonds => "♦",
        Suit.Clubs    => "♣",
        Suit.Spades   => "♠",
        _ => "?"
    };

    private static string RankText(Rank r) => r switch
    {
        Rank.Nine  => "9",
        Rank.Ten   => "10",
        Rank.Jack  => "J",
        Rank.Queen => "Q",
        Rank.King  => "K",
        Rank.Ace   => "A",
        _ => "?"
    };

    private static RenderFragment RenderPlayedCard(PlayedCard play) => builder =>
    {
        var card = play.Card;
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "trick-card" + (IsRed(card) ? " red" : ""));
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", "rank");
        builder.AddContent(4, RankText(card.Rank));
        builder.CloseElement();
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "suit");
        builder.AddContent(7, SuitSymbol(card.Suit));
        builder.CloseElement();
        builder.CloseElement();
    };

    protected override void OnInitialized()
    {
        Game.StateChanged += OnStateChanged;
    }

    public void Dispose()
    {
        Game.StateChanged -= OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task StartNewGameAsync()
    {
        BidPickerVisible = false;
        TrumpPickerVisible = false;
        RoundSummary = null;
        Game.StartNewGame();
        await DriveLoopAsync();
    }

    private async Task PlaceHumanBidAsync(BidAction action)
    {
        BidPickerVisible = false;
        Game.PlaceHumanBid(action);
        await DriveLoopAsync();
    }

    private async Task SelectTrumpAsync(Suit? trump)
    {
        TrumpPickerVisible = false;
        Game.SelectTrump(trump);
        await DriveLoopAsync();
    }

    private async Task OnNextRoundAsync()
    {
        RoundSummary = null;
        Game.StartNextRound();
        await DriveLoopAsync();
    }

    private RoundSummarySnapshot CaptureRoundSummary(bool isGameOver)
    {
        var s = State;
        var br = s?.BiddingResult;

        var usTricks = 0;
        var themTricks = 0;
        if (s is not null)
        {
            for (var i = 0; i < s.CompletedTricks.Count; i++)
            {
                var w = s.CompletedTricks[i].Winner;
                if (w is PlayerPosition.North or PlayerPosition.South) usTricks++;
                else themTricks++;
            }
        }

        var bidTeam = br?.Winner.GetTeam() ?? Team.NorthSouth;
        var biddingTeamTricks = bidTeam == Team.NorthSouth ? usTricks : themTricks;
        var defendingTeamTricks = 12 - biddingTeamTricks;
        var bidAmount = br?.BidAmount ?? 0;
        var isHawsey = br?.IsHawsey ?? false;

        int biddingDelta;
        if (isHawsey)
        {
            biddingDelta = biddingTeamTricks == 12 ? 24 : -24;
        }
        else
        {
            biddingDelta = biddingTeamTricks >= bidAmount ? biddingTeamTricks : -bidAmount;
        }
        var defendingDelta = defendingTeamTricks;

        var (usDelta, themDelta) = bidTeam == Team.NorthSouth
            ? (biddingDelta, defendingDelta)
            : (defendingDelta, biddingDelta);

        var made = isHawsey ? biddingTeamTricks == 12 : biddingTeamTricks >= bidAmount;
        var bidText = isHawsey ? "Hawsey (24)" : bidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var bidTeamLabel = bidTeam == Team.NorthSouth ? "US" : "THEM";

        var winnerLabel = "";
        if (isGameOver && s is not null)
        {
            var winner = s.NorthSouthScore >= s.Rules.PointsToWin ? Team.NorthSouth : Team.EastWest;
            winnerLabel = winner == Team.NorthSouth ? "US" : "THEM";
        }

        return new RoundSummarySnapshot
        (
            BidTeamLabel: bidTeamLabel,
            BidText: bidText,
            Made: made,
            UsTricks: usTricks,
            ThemTricks: themTricks,
            UsDelta: usDelta,
            ThemDelta: themDelta,
            UsTotal: s?.NorthSouthScore ?? 0,
            ThemTotal: s?.EastWestScore ?? 0,
            IsGameOver: isGameOver,
            GameWinnerLabel: winnerLabel
        );
    }

    private async Task DriveLoopAsync()
    {
        while (true)
        {
            var s = Game.CurrentState;
            if (s is null) return;

            switch (s.Phase)
            {
                case GamePhase.Bidding:
                    StatusMessage = "Bidding...";
                    var humanBids = await Game.AdvanceAiBiddingAsync();
                    if (humanBids)
                    {
                        BidPickerVisible = true;
                        StatusMessage = "Your turn to bid.";
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                    break;

                case GamePhase.TrumpSelection:
                    var humanPicksTrump = await Game.HandleTrumpSelectionAsync();
                    if (humanPicksTrump)
                    {
                        TrumpPickerVisible = true;
                        StatusMessage = "Pick trump.";
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                    break;

                case GamePhase.HawseyExchange:
                    await Game.HandleHawseyExchangeAsync();
                    break;

                case GamePhase.TrickPlay:
                    var humanPlays = await Game.AdvanceAiPlaysAsync();
                    if (humanPlays)
                    {
                        StatusMessage = "Your turn. Play a card.";
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                    break;

                case GamePhase.RoundScoring:
                    StatusMessage = "Round complete.";
                    RoundSummary = CaptureRoundSummary(isGameOver: false);
                    await InvokeAsync(StateHasChanged);
                    return;

                case GamePhase.GameOver:
                    StatusMessage = "Game over.";
                    if (RoundSummary is null)
                    {
                        RoundSummary = CaptureRoundSummary(isGameOver: true);
                        await InvokeAsync(StateHasChanged);
                    }
                    return;

                default:
                    return;
            }
        }
    }

    private async Task OnCardClickAsync(Card card)
    {
        if (!IsHumanPlayTurn) return;
        var legal = State!.GetLegalPlays();
        var found = false;
        for (var i = 0; i < legal.Count; i++)
        {
            if (legal[i].Equals(card)) { found = true; break; }
        }
        if (!found) return;

        await Game.PlayHumanCardAsync(card);
        await DriveLoopAsync();
    }
}
