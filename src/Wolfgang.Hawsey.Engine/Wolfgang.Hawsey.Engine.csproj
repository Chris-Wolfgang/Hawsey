<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <!-- AssemblyVersion is pinned at 1.0.0.0 (docs/adr/0006-pin-assemblyversion.md).
         The engine is not strong-named, so the pin has no binding effect today.
         FileVersion (derived below) and InformationalVersion (derived from
         <Version>) carry the release number; release.yaml requires the tag to
         match <Version>. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace("$(Version)", "[-+].*$", "")).0</FileVersion>
    <Authors>Chris Wolfgang</Authors>
    <Description>Game engine for the Hawsey card game — a 4-player team trick-taking game played with a pinochle deck.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The engine is reflection-free, so it can promise trimming and Native AOT
         to consumers. The ILLink analyzers these switch on only exist for
         net8.0+; the netstandard2.0 slot is unaffected. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
  </PropertyGroup>

  <!-- PolySharp emits its polyfill files in a run-dependent order, and the order of
       source documents is baked into the PDB (and so the DLL's PDB id): with every
       polyfill generated, two CI builds of one commit differed (found by
       reproducible-build.yaml). The engine only needs IsExternalInit (records and
       init accessors on netstandard2.0), and a single generated file has only one
       order. Add a type here if a netstandard2.0 build reports it missing.
       MemberNotNullWhenAttribute is for GameSession's IsBiddingOpen guard. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PolySharpIncludeGeneratedTypes>System.Runtime.CompilerServices.IsExternalInit;System.Diagnostics.CodeAnalysis.MemberNotNullWhenAttribute</PolySharpIncludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

</Project>
