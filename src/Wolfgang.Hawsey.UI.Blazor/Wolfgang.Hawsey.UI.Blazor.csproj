<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wolfgang.Hawsey.UI.Blazor</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Chris Wolfgang</Authors>
    <Description>Blazor WebAssembly host for the Hawsey card game.</Description>
    <Copyright>Copyright (c) Chris Wolfgang</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Hawsey.UI.Shared\Wolfgang.Hawsey.UI.Shared.csproj" />
  </ItemGroup>

</Project>
