<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wolfgang.Hawsey.UI.Blazor</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Blazor WebAssembly host for the Hawsey card game.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- An app, not a NuGet package (the SourceLink job skips non-packable projects),
         and its Razor components are not a documented API: opt out of the src/
         XML-doc default. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Hawsey.UI.Shared\Wolfgang.Hawsey.UI.Shared.csproj" />
  </ItemGroup>

</Project>
