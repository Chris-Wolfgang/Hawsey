<Project Sdk="Microsoft.NET.Sdk">

  <!-- Coyote systematic-concurrency tests for the engine's GameSession (#73, #834).
       After every build `dotnet coyote rewrite` instruments this assembly AND the
       copy of Wolfgang.Hawsey.Engine.dll in the output folder (GameSession lives
       there), so Coyote's TestingEngine controls the session's tasks and locks and
       explores their interleavings. Only the copy in this project's output is
       rewritten; the engine's own build output is untouched. The CLI comes from
       .config/dotnet-tools.json (`dotnet tool restore`).

       No coverlet.collector, on purpose: coverage instrumentation on top of
       Coyote's binary rewrite is unsupported. GameSession's coverage comes from
       the engine unit tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Coyote.Test" Version="1.7.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Hawsey.Engine\Wolfgang.Hawsey.Engine.csproj" />
  </ItemGroup>

  <!-- Restore first: any job that builds the solution (tests, InspectCode, CodeQL,
       Stryker) reaches this target, and not all of them run `dotnet tool restore`.
       Restore is idempotent and near-instant once the tool is cached. -->
  <Target Name="CoyoteRewrite" AfterTargets="Build">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)" StandardOutputImportance="low" />
    <Exec Command="dotnet coyote rewrite &quot;$(TargetDir)Wolfgang.Hawsey.Engine.dll&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec Command="dotnet coyote rewrite &quot;$(TargetPath)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

</Project>
